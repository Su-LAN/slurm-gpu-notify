#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
# AUTO-GENERATED by slurm-gpu-notify (sgn-monitor-install) from
# remote/gpu_report.sh.tmpl. Do NOT edit this copy on the cluster — edit the
# template in the repo and re-run `sgn-monitor-install`.
#
# Runs on the cluster login node (via crontab, hourly). Emails a status report
# for the invoking user's Slurm jobs:
#   • RUNNING jobs → GPU utilisation + memory + remaining walltime
#   • PENDING jobs → scheduler's estimated start / approximate wait
# Set SGN_NO_MAIL=1 to print to stdout without sending mail (used by sgn-status).
# ─────────────────────────────────────────────────────────────────────────────
@SLURM_PATH_LINE@
MAILTO="@EMAIL@"
GPU_STAT_VIA="@GPU_STAT_VIA@"
ME="$(whoami)"
NOW="$(date '+%Y-%m-%d %H:%M:%S %Z')"
OUT="$(mktemp)"

fmt_gpu() {   # reads `index,name,util,mem_used,mem_total` CSV rows on stdin
  while IFS=',' read -r idx name util mu mt; do
    idx="$(echo "$idx" | xargs)"; name="$(echo "$name" | xargs)"
    util="$(echo "$util" | xargs)"; mu="$(echo "$mu" | xargs)"; mt="$(echo "$mt" | xargs)"
    [ -z "$idx" ] && continue
    if [ "$util" = "[N/A]" ]; then u="N/A (MIG slice)"; else u="${util}%"; fi
    pct=""; [ -n "$mt" ] && [ "$mt" -gt 0 ] 2>/dev/null && pct=" ($((mu*100/mt))%)"
    echo "      GPU #${idx} ${name}: util ${u}, mem ${mu}/${mt} MiB${pct}"
  done
}

report_gpu_util() {   # $1 = jobid
  local jid="$1" idx
  case "$GPU_STAT_VIA" in
    none)
      echo "      (GPU utilisation reporting disabled)" ;;
    srun)
      timeout 45 srun --jobid="$jid" --overlap -n1 \
        nvidia-smi --query-gpu=index,name,utilization.gpu,memory.used,memory.total \
        --format=csv,noheader,nounits 2>/dev/null | fmt_gpu ;;
    *)  # login_idx: query the exact GPU index Slurm assigned, on the login node
      idx="$(scontrol show job "$jid" -d 2>/dev/null | grep -oP 'IDX:\K[0-9,]+' | head -1)"
      if [ -n "$idx" ]; then
        nvidia-smi --query-gpu=index,name,utilization.gpu,memory.used,memory.total \
          --format=csv,noheader,nounits --id="$idx" 2>/dev/null | fmt_gpu
      else
        echo "      (could not determine GPU index for job $jid)"
      fi ;;
  esac
}

secs_from_slurm_time() {   # converts D-HH:MM:SS / HH:MM:SS / MM:SS to seconds
  echo "$1" | awk -F'[-:]' '{n=NF;s=$n;m=(n>=2?$(n-1):0);h=(n>=3?$(n-2):0);d=(n>=4?$(n-3):0);print ((d*24+h)*60+m)*60+s}'
}

{
  echo "GPU status report for ${ME}"
  echo "Generated: ${NOW}   Host: $(hostname)"
  echo "================================================================"

  JOBS="$(squeue --me -h -o '%i|%j|%T' 2>/dev/null)"
  if [ -z "$JOBS" ]; then
    echo ""
    echo "No jobs in the queue right now."
  else
    n=0
    while IFS='|' read -r jid jname jstate; do
      [ -z "$jid" ] && continue
      n=$((n+1))
      echo ""
      echo "[$n] Job ${jid}  \"${jname}\"  --  ${jstate}"
      echo "----------------------------------------------------------------"
      if [ "$jstate" = "RUNNING" ]; then
        rt="$(squeue -j "$jid" -h -o '%M' 2>/dev/null)"
        tl="$(squeue -j "$jid" -h -o '%l' 2>/dev/null)"
        node="$(squeue -j "$jid" -h -o '%N' 2>/dev/null)"
        gres="$(squeue -j "$jid" -h -o '%b' 2>/dev/null)"
        echo "  Node: ${node}    GPU alloc: ${gres}"
        echo "  Runtime: ${rt} / ${tl}  (used / limit)"
        us="$(secs_from_slurm_time "$rt")"; ls="$(secs_from_slurm_time "$tl")"
        if [ -n "$us" ] && [ -n "$ls" ]; then
          rem=$((ls-us)); [ $rem -lt 0 ] && rem=0
          echo "  Remaining: $((rem/3600))h $(((rem%3600)/60))m until walltime ends"
        fi
        echo "  GPU usage:"
        report_gpu_util "$jid"
      elif [ "$jstate" = "PENDING" ]; then
        reason="$(squeue -j "$jid" -h -o '%r' 2>/dev/null)"
        start="$(squeue --start -j "$jid" -h -o '%S' 2>/dev/null)"
        echo "  Pending reason: ${reason}"
        echo "  Est. start: ${start}"
        if [ -n "$start" ] && [ "$start" != "N/A" ]; then
          secs=$(( $(date -d "$start" +%s 2>/dev/null) - $(date +%s) ))
          if [ "$secs" -gt 0 ] 2>/dev/null; then
            echo "  Approx wait: ~$((secs/3600))h $(((secs%3600)/60))m from now"
          else
            echo "  Approx wait: should start imminently"
          fi
        else
          echo "  Approx wait: unknown (scheduler has no estimate yet — resources busy)"
        fi
      else
        echo "  (state ${jstate})"
      fi
    done <<< "$JOBS"
  fi

  echo ""
  echo "================================================================"
  echo "(auto-generated hourly by slurm-gpu-notify; this mailbox is not monitored)"
} > "$OUT"

if [ -z "${SGN_NO_MAIL:-}" ]; then
  mail -s "[GPU] status report for ${ME} @ ${NOW}" "$MAILTO" < "$OUT"
fi
cat "$OUT"
rm -f "$OUT"
